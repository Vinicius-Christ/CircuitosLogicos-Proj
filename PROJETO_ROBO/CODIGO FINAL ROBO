
/*
   CARRINHO ROBO - DESVIO INTELIGENTE DE OBSTACULOS
   Servo + HC-SR04 + LCD I2C

   Autores: Vinicius Christ e Guilherme Ladislau

   FUNCIONAMENTO:
   - Acima de 50 cm: anda rapido.
   - Entre 21 e 50 cm: anda devagar.
   - A 20 cm ou menos: para, da re e faz uma varredura.
   - Servo varre de 20 a 160 graus.
   - Identifica a maior abertura livre.
   - Calcula o centro da abertura e escolhe a direcao.

   PINAGEM:

   L298N:
   ENA -> D11 (Motor A / esquerdo)
   IN1 -> D10
   IN2 -> D9
   IN3 -> D8
   IN4 -> D7
   ENB -> D6 (Motor B / direito)

   HC-SR04:
   TRIG -> D4
   ECHO -> D5

   Servo:
   SINAL -> D3

   LCD I2C:
   SDA -> A4
   SCL -> A5
*/

#include <Wire.h>
#include <Servo.h>
#include <LiquidCrystal_I2C.h>

// =================================================
// PINAGEM
// =================================================

// ---------- Ponte H L298N ----------

#define ENA 11
#define IN1 10
#define IN2 9
#define IN3 8
#define IN4 7
#define ENB 6

#define INVERTER_MOTORES true

// ---------- Sensor ----------

#define TRIG 4
#define ECHO 5

// ---------- Servo ----------

#define PINO_SERVO 3

#define SERVO_CENTRO 90
#define SERVO_MIN 20
#define SERVO_MAX 160

#define PASSO_VARREDURA 10
#define TEMPO_SERVO 150

// =================================================
// VELOCIDADES INDIVIDUAIS DOS MOTORES
// =================================================

// MOTOR B = ESQUERDO
// MOTOR A = DIREITO
//
// PWM: 0 a 255

// Frente rapida
#define VEL_RAPIDA_A 80
#define VEL_RAPIDA_B 97

// Frente devagar
#define VEL_DEVAGAR_A 60
#define VEL_DEVAGAR_B 77

// Marcha a re
#define VEL_RE_A 60
#define VEL_RE_B 77

// Giro
#define VEL_GIRO_A 50
#define VEL_GIRO_B 67

// =================================================
// DISTANCIAS
// =================================================

#define DIST_PARAR 25
#define DIST_DEVAGAR 50
#define DIST_LIVRE 60
#define DIST_MAX 400

// =================================================
// TEMPOS
// =================================================

#define TEMPO_RE 1500UL

const unsigned long TEMPO_GIRO_90 = 1200UL;
const unsigned long TEMPO_GIRO_PASSO = 600UL;

// =================================================
// VARREDURA
// =================================================

#define MIN_LEITURAS_LIVRES 2

// =================================================
// OBJETOS
// =================================================

LiquidCrystal_I2C lcd(0x27, 16, 2);
Servo servoSensor;

unsigned long ultimoLCD = 0;

// =================================================
// LCD
// =================================================

void mostrarLCD(const char *linha1, const char *linha2) {

  char l1[17];
  char l2[17];

  snprintf(l1, sizeof(l1), "%-16.16s", linha1);
  snprintf(l2, sizeof(l2), "%-16.16s", linha2);

  lcd.setCursor(0, 0);
  lcd.print(l1);

  lcd.setCursor(0, 1);
  lcd.print(l2);
}

// =================================================
// CONTROLE DOS MOTORES
// =================================================

void acionarMotores(
  bool frenteA,
  bool frenteB,
  int velMotorA,
  int velMotorB
) {

  // Inverte o sentido conforme a montagem dos motores

  if (INVERTER_MOTORES) {

    frenteA = !frenteA;
    frenteB = !frenteB;
  }

  // Motor A - esquerdo

  digitalWrite(IN1, frenteA ? HIGH : LOW);
  digitalWrite(IN2, frenteA ? LOW : HIGH);

  // Motor B - direito

  digitalWrite(IN3, frenteB ? HIGH : LOW);
  digitalWrite(IN4, frenteB ? LOW : HIGH);

  // Velocidades independentes

  analogWrite(ENA, constrain(velMotorA, 0, 255));
  analogWrite(ENB, constrain(velMotorB, 0, 255));
}

// =================================================
// PARAR MOTORES
// =================================================

void pararMotores() {

  analogWrite(ENA, 0);
  analogWrite(ENB, 0);

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
}

// =================================================
// MOVIMENTOS
// =================================================

void frente(int velA, int velB) {

  acionarMotores(true, true, velA, velB);
}

void darRe(int velA, int velB) {

  acionarMotores(false, false, velA, velB);
}

void virarDireita() {

  acionarMotores(
    true,
    false,
    VEL_GIRO_A,
    VEL_GIRO_B
  );
}

void virarEsquerda() {

  acionarMotores(
    false,
    true,
    VEL_GIRO_A,
    VEL_GIRO_B
  );
}

// =================================================
// SENSOR ULTRASSONICO
// =================================================

long lerDistancia() {

  long soma = 0;
  int validas = 0;

  for (int i = 0; i < 2; i++) {

    digitalWrite(TRIG, LOW);
    delayMicroseconds(2);

    digitalWrite(TRIG, HIGH);
    delayMicroseconds(10);

    digitalWrite(TRIG, LOW);

    unsigned long duracao = pulseIn(ECHO, HIGH, 25000);

    if (duracao > 0) {

      long d = duracao * 0.0343 / 2;

      if (d == 0) d = 1;

      if (d <= DIST_MAX) {

        soma += d;
        validas++;
      }
    }

    delay(10);
  }

  if (validas == 0) {

    return DIST_MAX;
  }

  return soma / validas;
}

// =================================================
// PROCURAR MAIOR ABERTURA LIVRE
// =================================================

int procurarMelhorDirecao() {

  const int TOTAL_LEITURAS =
    ((SERVO_MAX - SERVO_MIN) / PASSO_VARREDURA) + 1;

  int distancias[TOTAL_LEITURAS];
  int angulos[TOTAL_LEITURAS];

  int indice = 0;

  char linha[17];

  // ---------- VARREDURA ----------

  mostrarLCD("Fazendo", "varredura...");

  for (
    int angulo = SERVO_MIN;
    angulo <= SERVO_MAX;
    angulo += PASSO_VARREDURA
  ) {

    servoSensor.write(angulo);

    delay(TEMPO_SERVO);

    long distancia = lerDistancia();

    distancias[indice] = distancia;
    angulos[indice] = angulo;

    snprintf(
      linha,
      sizeof(linha),
      "%3d graus %3ldcm",
      angulo,
      distancia
    );

    mostrarLCD("Analisando rota", linha);

    indice++;
  }

  // ---------- PROCURAR MAIOR SEQUENCIA ----------

  int melhorInicio = -1;
  int melhorFim = -1;

  int inicioAtual = -1;
  int tamanhoAtual = 0;
  int maiorTamanho = 0;

  for (int i = 0; i < TOTAL_LEITURAS; i++) {

    if (distancias[i] >= DIST_LIVRE) {

      if (tamanhoAtual == 0) {

        inicioAtual = i;
      }

      tamanhoAtual++;

      if (tamanhoAtual > maiorTamanho) {

        maiorTamanho = tamanhoAtual;

        melhorInicio = inicioAtual;
        melhorFim = i;
      }

    } else {

      tamanhoAtual = 0;
      inicioAtual = -1;
    }
  }

  // ---------- CALCULAR CENTRO DA ABERTURA ----------

  if (maiorTamanho >= MIN_LEITURAS_LIVRES) {

    int anguloInicio = angulos[melhorInicio];
    int anguloFim = angulos[melhorFim];

    int melhorAngulo =
      (anguloInicio + anguloFim) / 2;

    servoSensor.write(SERVO_CENTRO);

    delay(TEMPO_SERVO);

    snprintf(
      linha,
      sizeof(linha),
      "Angulo: %3d",
      melhorAngulo
    );

    mostrarLCD("Melhor abertura", linha);

    delay(500);

    return melhorAngulo;
  }

  // ---------- NENHUMA ABERTURA ----------

  servoSensor.write(SERVO_CENTRO);

  delay(TEMPO_SERVO);

  return -1;
}

// =================================================
// PROCURAR CAMINHO
// =================================================

void procurarCaminho() {

  pararMotores();

  mostrarLCD("Obstaculo", "encontrado!");

  delay(700);

  // ---------- DAR RE ----------

  mostrarLCD("Obstaculo!", "Dando re...");

  darRe(VEL_RE_A, VEL_RE_B);

  delay(TEMPO_RE);

  pararMotores();

  delay(250);

  // ---------- FAZER VARREDURA ----------

  int melhorAngulo = procurarMelhorDirecao();

  // ---------- ESCOLHER DIRECAO ----------

  if (melhorAngulo != -1) {

    // ANGULO MENOR QUE 90 = DIREITA
    // Comandos invertidos conforme a calibracao anterior.

    if (melhorAngulo < SERVO_CENTRO) {

      mostrarLCD("Melhor caminho", "Direita!");

      virarEsquerda();

      delay(TEMPO_GIRO_90);
    }

    // ANGULO MAIOR QUE 90 = ESQUERDA

    else if (melhorAngulo > SERVO_CENTRO) {

      mostrarLCD("Melhor caminho", "Esquerda!");

      virarDireita();

      delay(TEMPO_GIRO_90);
    }

    // ABERTURA CENTRAL

    else {

      mostrarLCD("Melhor caminho", "Frente!");

      frente(VEL_DEVAGAR_A, VEL_DEVAGAR_B);

      delay(500);
    }

    pararMotores();

    delay(300);

    return;
  }

  // ---------- NENHUMA SAIDA ENCONTRADA ----------

  mostrarLCD("Sem saida!", "Procurando...");

  for (int tentativa = 0; tentativa < 6; tentativa++) {

    virarEsquerda();

    delay(TEMPO_GIRO_PASSO);

    pararMotores();

    delay(200);

    if (lerDistancia() >= DIST_LIVRE) {

      mostrarLCD("Rota encontrada!", "Seguindo...");

      delay(400);

      return;
    }
  }

  pararMotores();

  mostrarLCD("Sem caminho!", "Tentando outra");

  delay(500);
}

// =================================================
// SETUP
// =================================================

void setup() {

  pinMode(ENA, OUTPUT);

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);

  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  pinMode(ENB, OUTPUT);

  pinMode(TRIG, OUTPUT);
  pinMode(ECHO, INPUT);

  digitalWrite(TRIG, LOW);

  pararMotores();

  servoSensor.attach(PINO_SERVO);

  servoSensor.write(SERVO_CENTRO);

  lcd.init();

  lcd.backlight();

  mostrarLCD("Carrinho Robo", "Inicializando...");

  delay(1500);
}

// =================================================
// LOOP PRINCIPAL
// =================================================

void loop() {

  char linha[17];

  long distancia = lerDistancia();

  // ---------- OBSTACULO PROXIMO ----------

  if (distancia <= DIST_PARAR) {

    procurarCaminho();

    return;
  }

  // ---------- CONTROLE DE VELOCIDADE ----------

  const char *estado;

  if (distancia <= DIST_DEVAGAR) {

    frente(VEL_DEVAGAR_A, VEL_DEVAGAR_B);

    estado = "Devagar...";
  }

  else {

    frente(VEL_RAPIDA_A, VEL_RAPIDA_B);

    estado = "Andando...";
  }

  // ---------- ATUALIZAR LCD ----------

  unsigned long agora = millis();

  if (agora - ultimoLCD >= 180) {

    ultimoLCD = agora;

    if (distancia >= DIST_MAX) {

      strcpy(linha, "Dist: >400 cm");
    }

    else {

      snprintf(
        linha,
        sizeof(linha),
        "Dist: %3ld cm",
        distancia
      );
    }

    mostrarLCD(estado, linha);
  }
}
